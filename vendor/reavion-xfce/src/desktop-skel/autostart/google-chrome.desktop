[Desktop Entry]
Type=Application
Version=1.0
Name=Google Chrome
Comment=Start Chrome ready for agent browser bind
Exec=/usr/local/bin/google-chrome-wrapper.sh about:blank
Terminal=false
Icon=google-chrome
Categories=Network;WebBrowser;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-XFCE-Autostart-Override=true
