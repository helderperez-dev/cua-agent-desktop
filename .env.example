# VNC password for the noVNC viewer (/vnc.html)
# Replace changeme with a strong password before any real / Railway use.
VNC_PW=changeme

# Public edge port inside the container (Railway sets this automatically)
PORT=8080

# Required for remote MCP on Railway. Clients send: Authorization: Bearer <key>
# Generate e.g.: openssl rand -hex 32
MCP_API_KEY=

# Set to 1 on Railway so the gateway refuses to start without MCP_API_KEY
REQUIRE_MCP_API_KEY=0

# Optional overrides:
# CUA_RUNTIME=docker
# CUA_CONTAINER=cua-agent-desktop
# MCP_GATEWAY_PORT=8200
